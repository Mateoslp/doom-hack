/**
 * EntityManager.jack
 * Gestor central de Object Pools de tamano fijo para enemigos (enemies[4]) y
 * proyectiles fisicos (projectiles[5]), generador pseudoaleatorio seguro en 16 bits
 * y controlador de aparicion escalada por oleadas
 * (Modulo 4 del Plan Modular de Desarrollo / Capa 3 / Ficha Tecnica #11).
 *
 * Garantia estricta de memoria:
 *   - Reserva los 2 Array, los 4 Enemy y los 5 Projectile UNA SOLA VEZ en new().
 *   - Cero llamadas a new / Memory.alloc durante reset(), updateEntities(),
 *     updateProjectilesPhysics(), spawnEnemy() y spawnProjectile().
 *   - Libera simetricamente las 9 entidades, los 2 Array y this en dispose().
 */
class EntityManager {

    field Array enemies;
    field Array projectiles;
    field int spawnTimer;
    field int rngState;

    /** Preasigna en el heap los pools fijos enemies[4] y projectiles[5]. */
    constructor EntityManager new() {
        var int i;
        var int maxE;
        var int maxP;

        let maxE = GameConstants.maxEnemies();
        let maxP = GameConstants.maxProjectiles();

        let enemies = Array.new(maxE);
        let i = 0;
        while (i < maxE) {
            let enemies[i] = Enemy.new();
            let i = (i + 1);
        }

        let projectiles = Array.new(maxP);
        let i = 0;
        while (i < maxP) {
            let projectiles[i] = Projectile.new();
            let i = (i + 1);
        }

        let rngState = 137;
        let spawnTimer = 6;
        return this;
    }

    /**
     * Desactiva todas las entidades de ambos pools y restablece el temporizador de
     * aparicion inicial sin realizar ninguna operacion sobre el heap.
     * Conserva la entropia acumulada en rngState.
     */
    method void reset() {
        var int i;
        var int maxE;
        var int maxP;
        var Enemy e;
        var Projectile p;

        let maxE = GameConstants.maxEnemies();
        let i = 0;
        while (i < maxE) {
            let e = enemies[i];
            if (~(e = null)) {
                do e.deactivate();
            }
            let i = (i + 1);
        }

        let maxP = GameConstants.maxProjectiles();
        let i = 0;
        while (i < maxP) {
            let p = projectiles[i];
            if (~(p = null)) {
                do p.deactivate();
            }
            let i = (i + 1);
        }

        let spawnTimer = 6;
        if (~(rngState > 0)) {
            let rngState = 137;
        }
        return;
    }

    /** Perturba la semilla pseudoaleatoria durante la espera interactiva en MENU. */
    method void tickSeed() {
        let rngState = ((rngState + 37) & 16383);
        if (rngState = 0) {
            let rngState = 137;
        }
        return;
    }

    /**
     * [Interno] RNG congruencial lineal seguro en 16 bits con signo:
     *   rngState <- (((rngState & 255) * 109) + 89) & 16383
     * Maximo intermedio: 255 * 109 + 89 = 27884 <= 32767 (cero riesgo de overflow).
     * Retorna un entero en [0, span - 1] para span > 1, o 0 si span <= 1.
     */
    method int nextRandomBounded(int span) {
        let rngState = ((((rngState & 255) * 109) + 89) & 16383);
        if (~(span > 1)) {
            return 0;
        }
        return MathUtils.mod(rngState, span);
    }

    /**
     * Actualiza todos los enemigos activos y gestiona la aparicion progresiva en zSpawn (100)
     * escalando cupo simultaneo, cadencia y variantes segun currentWave (GDD Seccion I):
     *   - Oleada 1: hasta 2 enemigos activos, solo Tipo 1, cadencia 24 ticks.
     *   - Oleada 2: hasta 3 enemigos activos, mezcla Tipo 1 y Tipo 2, cadencia 20 ticks.
     *   - Oleada 3+: hasta 4 enemigos activos, mezcla 50/50 Tipo 1 y Tipo 2, cadencia 16 ticks.
     */
    method void updateEntities(int currentWave) {
        var int i;
        var int maxE;
        var Enemy e;
        var int safeWave;
        var int waveCap;
        var int cooldown;
        var int spawnX;
        var int strafe;
        var int eType;

        let maxE = GameConstants.maxEnemies();
        let i = 0;
        while (i < maxE) {
            let e = enemies[i];
            if (~(e = null)) {
                if (e.isActive()) {
                    do e.update();
                }
            }
            let i = (i + 1);
        }

        let safeWave = currentWave;
        if (safeWave < 1) {
            let safeWave = 1;
        }

        if (safeWave = 1) {
            let waveCap = 2;
            let cooldown = 24;
        } else {
            if (safeWave = 2) {
                let waveCap = 3;
                let cooldown = 20;
            } else {
                let waveCap = maxE;
                let cooldown = 16;
            }
        }

        if (getActiveEnemyCount() < waveCap) {
            if (spawnTimer > 0) {
                let spawnTimer = (spawnTimer - 1);
            } else {
                let spawnX = (nextRandomBounded(257) - 128);

                if (safeWave = 1) {
                    let eType = 1;
                    let strafe = (nextRandomBounded(5) - 2);
                } else {
                    if (safeWave = 2) {
                        if (nextRandomBounded(3) = 0) {
                            let eType = 2;
                        } else {
                            let eType = 1;
                        }
                    } else {
                        if (nextRandomBounded(2) = 0) {
                            let eType = 2;
                        } else {
                            let eType = 1;
                        }
                    }
                    let strafe = (nextRandomBounded(9) - 4);
                    if (strafe = 0) {
                        let strafe = 2;
                    }
                }

                do spawnEnemy(eType, spawnX, GameConstants.zSpawn(), strafe);
                let spawnTimer = cooldown;
            }
        }

        return;
    }

    /** Delega la integracion gravitacional y de rebotes del pool de proyectiles a PhysicsEngine. */
    method void updateProjectilesPhysics() {
        do PhysicsEngine.updatePool(projectiles, GameConstants.maxProjectiles());
        return;
    }

    /**
     * Busca la primera ranura libre en enemies[0..3] y activa un enemigo en ella.
     * Retorna false si las 4 ranuras ya estan ocupadas (cero asignacion dinamica).
     */
    method boolean spawnEnemy(int type, int startX, int startZ, int strafeVx) {
        var int i;
        var int maxE;
        var Enemy e;

        let maxE = GameConstants.maxEnemies();
        let i = 0;
        while (i < maxE) {
            let e = enemies[i];
            if (~(e = null)) {
                if (~(e.isActive())) {
                    do e.spawn(type, startX, startZ, strafeVx);
                    return true;
                }
            }
            let i = (i + 1);
        }
        return false;
    }

    /**
     * Busca la primera ranura libre en projectiles[0..4] y activa un orbe fisico en ella.
     * Retorna false si las 5 ranuras ya estan ocupadas (cero asignacion dinamica).
     */
    method boolean spawnProjectile(int worldX, int worldY, int startZ, int vx, int vy, int vz, int dmg) {
        var int i;
        var int maxP;
        var Projectile p;

        let maxP = GameConstants.maxProjectiles();
        let i = 0;
        while (i < maxP) {
            let p = projectiles[i];
            if (~(p = null)) {
                if (~(p.isActive())) {
                    do p.spawn(worldX, worldY, startZ, vx, vy, vz, dmg);
                    return true;
                }
            }
            let i = (i + 1);
        }
        return false;
    }

    /** Retorna la referencia al arreglo fijo enemies[4] para colisiones y renderizado. */
    method Array getEnemies() {
        return enemies;
    }

    /** Retorna la referencia al arreglo fijo projectiles[5] para colisiones y renderizado. */
    method Array getProjectiles() {
        return projectiles;
    }

    /** Cuenta cuantos enemigos se encuentran activos actualmente en enemies[0..3]. */
    method int getActiveEnemyCount() {
        var int i;
        var int maxE;
        var int count;
        var Enemy e;

        let maxE = GameConstants.maxEnemies();
        let count = 0;
        let i = 0;
        while (i < maxE) {
            let e = enemies[i];
            if (~(e = null)) {
                if (e.isActive()) {
                    let count = (count + 1);
                }
            }
            let i = (i + 1);
        }
        return count;
    }

    /** Libera simetricamente los 4 Enemy, los 5 Projectile, ambos Array y esta instancia. */
    method void dispose() {
        var int i;
        var int maxE;
        var int maxP;
        var Enemy e;
        var Projectile p;

        if (~(enemies = null)) {
            let maxE = GameConstants.maxEnemies();
            let i = 0;
            while (i < maxE) {
                let e = enemies[i];
                if (~(e = null)) {
                    do e.dispose();
                }
                let i = (i + 1);
            }
            do enemies.dispose();
        }

        if (~(projectiles = null)) {
            let maxP = GameConstants.maxProjectiles();
            let i = 0;
            while (i < maxP) {
                let p = projectiles[i];
                if (~(p = null)) {
                    do p.dispose();
                }
                let i = (i + 1);
            }
            do projectiles.dispose();
        }

        do Memory.deAlloc(this);
        return;
    }
}

